{
  "expo": {
    "name": "Hebigat Radio",
    "slug": "subwave",
    "scheme": "hebigatradio",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/b834b64c-f694-4f45-b3fa-0f2c0a4df5ba",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.didaskitchen.hebigatradio",
      "appleTeamId": "BU9RD766GN",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.didaskitchen.hebigatradio"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSLocalNetworkUsageDescription": "Hebigat Radio uses the local network to find Google Cast and DLNA speakers and receivers on your Wi-Fi so you can send the station to them.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.didaskitchen.hebigatradio",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#0b101b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "LEANBACK_LAUNCHER",
            "LAUNCHER"
          ]
        }
      ],
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      "expo-font",
      [
        "react-native-google-cast",
        {
          "androidPlayServicesCastFrameworkVersion": "22.3.1"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b101b"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "usesCleartextTraffic": true,
            "enableLegacyPackaging": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "./plugins/withGradleVersion",
        {
          "version": "8.14.3"
        }
      ],
      "./plugins/withAndroidUserCaTrust",
      "./plugins/withGradleMemory",
      "./plugins/withAndroidTv",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "featuredStation": {
        "url": "https://radio.didaskitchen.com",
        "name": "Hebigat Radio"
      },
      "directoryUrl": "https://radio.didaskitchen.com",
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.didaskitchen.hebigatradio.widget",
                  "targetName": "SUBWAVELive",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.didaskitchen.hebigatradio"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "82556340-3c38-4b69-9835-eea34d7a4a07"
      }
    },
    "owner": "metallicats"
  }
}
